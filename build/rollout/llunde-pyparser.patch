diff --git a/ci/dependency_plan.py b/ci/dependency_plan.py
new file mode 100644
index 0000000000000000000000000000000000000000..b20fca2ac1ad5fe724363a0e405dfaf4dbe0c983
--- /dev/null
+++ b/ci/dependency_plan.py
@@ -0,0 +1,123 @@
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import re
+import subprocess
+from pathlib import Path
+
+SOURCE_INPUTS = ("pyproject.toml", "uv.lock", "ci/dependencies.Containerfile")
+INFRA_INPUTS = (
+    ".github/workflows/build-image.yml",
+    ".github/actions/setup-infra/action.yml",
+    "build/cli-release.json",
+    "build/toolchain.json",
+    "internal/pipeline/image.go",
+    "internal/pipeline/config.go",
+    "internal/cli/pipeline.go",
+    "internal/ci/arguments.go",
+    "go.mod",
+    "go.sum",
+)
+
+
+def digest(value: bytes) -> str:
+    return hashlib.sha256(value).hexdigest()
+
+
+def source_digest(root: Path) -> str:
+    entries = subprocess.check_output(["git", "ls-tree", "HEAD", "--", *SOURCE_INPUTS], cwd=root)
+    if len(entries.splitlines()) != len(SOURCE_INPUTS):
+        raise ValueError("dependency source input missing")
+    return digest(entries)
+
+
+def build_contract(root: Path, infra: Path) -> tuple[str, dict]:
+    recipe = json.loads((root / "ci/dependency-build.json").read_text())
+    supported = {
+        "schema": 1,
+        "image": "ghcr.io/fredrir/pyparser-dependencies",
+        "context": ".",
+        "dockerfile": "ci/dependencies.Containerfile",
+        "target": "",
+        "platform": "linux/amd64",
+        "build_args": {},
+        "revision_args": ["CI_REVISION", "GIT_SHA", "REVISION"],
+        "check_target": "",
+        "test_command": "",
+    }
+    if recipe != supported:
+        raise ValueError("unsupported dependency build contract")
+    revision = subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=infra, text=True).strip()
+    workflow = (root / ".github/workflows/dependencies.yml").read_text()
+    declared = re.findall(
+        r"fredrir/infra/\.github/workflows/build-image.yml@([a-f0-9]{40})", workflow
+    )
+    if declared != [revision]:
+        raise ValueError("dependency workflow and infrastructure checkout differ")
+    workflow = workflow.replace(revision, "<infra-revision>")
+    workflow = re.sub(r"(pin-dependencies\.yml@)[a-f0-9]{40}", r"\1<pin-helper>", workflow)
+    inputs = {name: digest((infra / name).read_bytes()) for name in INFRA_INPUTS}
+    context = {
+        name: digest((root / name).read_bytes())
+        for name in (".dockerignore", ".gitignore", "ci/dependency_plan.py")
+    }
+    contract = {
+        "recipe": recipe,
+        "infrastructure": inputs,
+        "context": context,
+        "workflow": digest(workflow.encode()),
+    }
+    return digest(json.dumps(contract, sort_keys=True, separators=(",", ":")).encode()), recipe
+
+
+def requires_build(manifest: dict, inputs: str, contract: str) -> bool:
+    if not isinstance(manifest, dict):
+        return True
+    compatibility = manifest.get("build_compatibility")
+    compatible = compatibility.get("contract_sha256") if isinstance(compatibility, dict) else None
+    return not (
+        manifest.get("schema") == 1
+        and isinstance(manifest.get("image"), str)
+        and re.fullmatch(
+            r"ghcr.io/fredrir/pyparser-dependencies@sha256:[a-f0-9]{64}", manifest.get("image", "")
+        )
+        and manifest.get("inputs_sha256") == inputs
+        and contract in (manifest.get("build_contract_sha256"), compatible)
+    )
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("command", choices=("plan", "contract"))
+    parser.add_argument("--root", type=Path, default=Path("."))
+    parser.add_argument("--infra-root", type=Path, required=True)
+    parser.add_argument("--github-output", type=Path)
+    args = parser.parse_args()
+    contract, recipe = build_contract(args.root, args.infra_root)
+    inputs = source_digest(args.root)
+    result = {"inputs_sha256": inputs, "contract_sha256": contract}
+    if args.command == "plan":
+        try:
+            manifest = json.loads((args.root / "ci/dependencies.json").read_text())
+        except (OSError, ValueError):
+            manifest = {}
+        result["build"] = requires_build(manifest, inputs, contract)
+        result.update({key: recipe[key] for key in ("image", "context", "dockerfile", "target")})
+        result["build_args"] = "\n".join(
+            f"{key}={value}" for key, value in sorted(recipe["build_args"].items())
+        )
+    if args.github_output:
+        with args.github_output.open("a") as output:
+            for key, value in result.items():
+                if isinstance(value, bool):
+                    value = str(value).lower()
+                if "\n" in str(value):
+                    raise ValueError("multiline dependency workflow output")
+                output.write(f"{key}={value}\n")
+    print(json.dumps(result, sort_keys=True))
+
+
+if __name__ == "__main__":
+    main()
