+name: Prepare parser dependencies
+on:
+  push:
+    branches: [main]
+    paths:
+      - pyproject.toml
+      - uv.lock
+      - ci/dependencies.Containerfile
+      - .github/workflows/dependencies.yml
+      - ci/dependency-build.json
+      - ci/dependency_plan.py
+      - .dockerignore
+      - .gitignore
+permissions:
+  contents: read
+concurrency:
+  group: parser-dependencies
+  cancel-in-progress: true
+env:
+  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24: true
+jobs:
+  plan:
+    runs-on: ubuntu-24.04
+    outputs:
+      build: ${{ steps.plan.outputs.build }}
+      contract: ${{ steps.plan.outputs.contract_sha256 }}
+      image: ${{ steps.plan.outputs.image }}
+      context: ${{ steps.plan.outputs.context }}
+      dockerfile: ${{ steps.plan.outputs.dockerfile }}
+      target: ${{ steps.plan.outputs.target }}
+      build-args: ${{ steps.plan.outputs.build_args }}
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
+        with:
+          persist-credentials: false
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
+        with:
+          repository: fredrir/infra
+          ref: a57b0e15d5ca1c3180fba6a16cedbc7595e90610
+          path: .infra-dependency-recipe
+          persist-credentials: false
+      - id: plan
+        run: python3 ci/dependency_plan.py plan --infra-root .infra-dependency-recipe --github-output "$GITHUB_OUTPUT"
+  image:
+    needs: plan
+    if: needs.plan.outputs.build == 'true'
+    permissions:
+      contents: read
+      packages: write
+      id-token: write
+      attestations: write
+    uses: fredrir/infra/.github/workflows/build-image.yml@a57b0e15d5ca1c3180fba6a16cedbc7595e90610
+    with:
+      image: ${{ needs.plan.outputs.image }}
+      context: ${{ needs.plan.outputs.context }}
+      dockerfile: ${{ needs.plan.outputs.dockerfile }}
+      target: ${{ needs.plan.outputs.target }}
+      build-args: ${{ needs.plan.outputs.build-args }}
+      deploy: false
+      timeout-minutes: 120
+  pin:
+    needs: [plan, image]
+    permissions:
+      contents: read
+      packages: read
+      id-token: write
+    uses: fredrir/llunde-pyparser/.github/workflows/pin-dependencies.yml@fbd1c5e18819a58f6f29f0dd9be49682fad1c800
+    with:
+      image: ${{ needs.image.outputs.image }}
+      build-contract: ${{ needs.plan.outputs.contract }}
+      workflow-revision: a57b0e15d5ca1c3180fba6a16cedbc7595e90610
