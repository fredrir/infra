index 0000000000000000000000000000000000000000..3c0cc9b562abc2711bb2b5b39574523d91422fd0
--- /dev/null
+++ b/.github/workflows/import-prepared-dependencies.yml
@@ -0,0 +1,64 @@
+name: Import locally prepared parser dependencies
+on:
+  workflow_dispatch:
+permissions:
+  contents: read
+concurrency:
+  group: parser-prepared-import
+  cancel-in-progress: false
+env:
+  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24: true
+jobs:
+  publish:
+    if: github.repository == 'fredrir/llunde-pyparser' && github.repository_owner_id == '114402558' && github.ref == 'refs/heads/main' && github.ref_protected && vars.INFRA_VM_POOL_QUALIFIED == 'true'
+    runs-on: ${{ 'dagger-amd64' }}
+    timeout-minutes: 15
+    permissions:
+      contents: read
+      packages: write
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
+        with:
+          persist-credentials: false
+      - name: Verify and publish prepared archive
+        env:
+          GH_TOKEN: ${{ github.token }}
+          REGISTRY_USER: ${{ github.actor }}
+        run: |
+          set -euo pipefail
+          archive=/var/lib/infra-parser-preparation/base.tar
+          receipt=ci/prepared-dependencies.json
+          for directory in /var /var/lib /var/lib/infra-parser-preparation; do
+            test -d "$directory" && test ! -L "$directory"
+            test "$(stat -c %u "$directory")" = 0
+            test "$((8#$(stat -c %a "$directory") & 0022))" = 0
+          done
+          test -f "$archive" && test ! -L "$archive"
+          test "$(stat -c %u "$archive")" = 0
+          test "$(stat -c %a "$archive")" = 640
+          expected=$(git ls-tree HEAD -- pyproject.toml uv.lock ci/dependencies.Containerfile | sha256sum | cut -d' ' -f1)
+          jq -e --arg inputs "$expected" '.schema == 1 and .origin == "maintainer-local-archie" and .inputs_sha256 == $inputs and .scan.exit_code == 0 and .scan.tool == "trivy" and .scan.version == "0.74.0" and .scan.scanners == ["vuln"] and .scan.severities == ["HIGH", "CRITICAL"] and .scan.ignore_unfixed == true and .scan.archive_sha256 == .archive_sha256' "$receipt"
+          scan_time=$(date --date="$(jq -er .scan.completed_at "$receipt")" +%s)
+          age=$(( $(date +%s) - scan_time ))
+          test "$age" -ge 0 && test "$age" -le 86400
+          checksum=$(jq -er '.archive_sha256 | select(test("^[a-f0-9]{64}$"))' "$receipt")
+          source=$(jq -er '.source_revision | select(test("^[a-f0-9]{40}$"))' "$receipt")
+          printf '%s  %s\n' "$checksum" "$archive" | sha256sum --check --strict
+          manifest=$(tar -xOf "$archive" index.json | jq -er '.manifests[0].digest | select(test("^sha256:[a-f0-9]{64}$"))')
+          config=$(tar -xOf "$archive" "blobs/sha256/${manifest#sha256:}" | jq -er '.config.digest | select(test("^sha256:[a-f0-9]{64}$"))')
+          export DOCKER_CONFIG
+          DOCKER_CONFIG=$(mktemp -d)
+          trap 'docker logout ghcr.io >/dev/null 2>&1 || true; rm -rf "$DOCKER_CONFIG"' EXIT
+          printf '%s' "$GH_TOKEN" | docker login ghcr.io --username "$REGISTRY_USER" --password-stdin
+          if ! docker image inspect "$manifest" >/dev/null 2>&1 && ! docker image inspect "$config" >/dev/null 2>&1; then
+            docker load --input "$archive"
+          fi
+          loaded="$manifest"
+          if ! docker image inspect "$loaded" >/dev/null 2>&1; then loaded="$config"; fi
+          test "$(docker image inspect "$loaded" --format '{{index .Config.Labels "org.opencontainers.image.revision"}}')" = "$source"
+          test "$(docker image inspect "$loaded" --format '{{.Os}}/{{.Architecture}}')" = linux/amd64
+          image="ghcr.io/fredrir/pyparser-dependencies:prepared-${source:0:12}"
+          docker tag "$loaded" "$image"
+          docker push "$image"
+          digest=$(docker image inspect "$image" --format '{{json .RepoDigests}}' | jq -er '.[] | select(test("^ghcr.io/fredrir/pyparser-dependencies@sha256:[a-f0-9]{64}$"))')
+          printf 'Locally prepared dependency image: `%s`\n\nSource: `%s`\n\nArchive: `%s`\n' "$digest" "$source" "$checksum" >> "$GITHUB_STEP_SUMMARY"
diff --git a/.github/workflows/pin-dependencies.yml b/.github/workflows/pin-dependencies.yml
new file mode 100644
index 0000000000000000000000000000000000000000..ccf24337c1f80bf222f3ce85a8a0429bb6d4d24b
--- /dev/null
+++ b/.github/workflows/pin-dependencies.yml
@@ -0,0 +1,107 @@
+name: Pin verified parser dependencies
+on:
+  workflow_call:
+    inputs:
+      image:
+        required: true
+        type: string
+      build-contract:
+        required: true
+        type: string
+      workflow-revision:
+        required: true
+        type: string
+permissions:
+  contents: read
+concurrency:
+  group: parser-dependency-pin
+  cancel-in-progress: false
+env:
+  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24: true
+jobs:
+  pin:
+    if: github.repository == 'fredrir/llunde-pyparser' && github.repository_owner_id == '114402558' && github.ref == 'refs/heads/main' && github.ref_protected && github.event_name == 'push'
+    runs-on: ubuntu-24.04
+    permissions:
+      contents: read
+      packages: read
+      id-token: write
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
+        with:
+          ref: main
+          fetch-depth: 0
+          persist-credentials: false
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
+        with:
+          repository: fredrir/infra
+          ref: ${{ inputs.workflow-revision }}
+          path: .infra-dependency-recipe
+          persist-credentials: false
+      - name: Install pinned verifier
+        run: |
+          curl --fail --silent --show-error --location --retry 2 --max-time 30 https://github.com/fredrir/infra/releases/download/cosign-v3.1.3-infra.1/cosign-linux-amd64 --output "$RUNNER_TEMP/cosign"
+          printf '05e004d22d93dc6dffb1b1633c1a03fcf0369b2f6eb247b714e236b61a742c71  %s/cosign\n' "$RUNNER_TEMP" | sha256sum --check --strict
+          chmod 755 "$RUNNER_TEMP/cosign"
+          printf '%s\n' "$RUNNER_TEMP" >> "$GITHUB_PATH"
+      - name: Verify dependency image
+        env:
+          IMAGE: ${{ inputs.image }}
+          WORKFLOW_REVISION: ${{ inputs.workflow-revision }}
+          REGISTRY_TOKEN: ${{ github.token }}
+        run: |
+          set -euo pipefail
+          [[ "$IMAGE" =~ ^ghcr\.io/fredrir/pyparser-dependencies@sha256:[a-f0-9]{64}$ ]]
+          [[ "$WORKFLOW_REVISION" =~ ^[a-f0-9]{40}$ ]]
+          export DOCKER_CONFIG="$RUNNER_TEMP/dependency-registry"
+          mkdir -m700 "$DOCKER_CONFIG"
+          trap 'rm -rf "$DOCKER_CONFIG"' EXIT
+          umask 077
+          jq -n '{auths:{"ghcr.io":{username:env.GITHUB_ACTOR,password:env.REGISTRY_TOKEN}}}' > "$DOCKER_CONFIG/config.json"
+          unset REGISTRY_TOKEN
+          cosign verify --certificate-oidc-issuer https://token.actions.githubusercontent.com \
+            --certificate-identity "https://github.com/fredrir/infra/.github/workflows/build-image.yml@$WORKFLOW_REVISION" \
+            --certificate-github-workflow-repository "$GITHUB_REPOSITORY" \
+            --certificate-github-workflow-sha "$GITHUB_SHA" \
+            --certificate-github-workflow-ref refs/heads/main \
+            --certificate-github-workflow-trigger push \
+            --annotations "source-repository=$GITHUB_REPOSITORY" \
+            --annotations "source-revision=$GITHUB_SHA" \
+            --annotations "workflow-revision=$WORKFLOW_REVISION" "$IMAGE"
+      - uses: octo-sts/action@a48df0af0fefd5197a00306a77dd198cdf442a76
+        id: token
+        with:
+          scope: fredrir/llunde-pyparser
+          identity: dependencies
+      - name: Pin current dependency inputs
+        env:
+          BUILD_CONTRACT: ${{ inputs.build-contract }}
+          IMAGE: ${{ inputs.image }}
+          GH_TOKEN: ${{ steps.token.outputs.token }}
+        run: |
+          set -euo pipefail
+          expected=$(git ls-tree "$GITHUB_SHA" -- pyproject.toml uv.lock ci/dependencies.Containerfile | sha256sum | cut -d' ' -f1)
+          for attempt in 1 2 3; do
+            git -c credential.helper='!gh auth git-credential' fetch --quiet origin main
+            git reset --hard FETCH_HEAD
+            current=$(git ls-tree HEAD -- pyproject.toml uv.lock ci/dependencies.Containerfile | sha256sum | cut -d' ' -f1)
+            test "$current" = "$expected"
+            contract=$(python3 ci/dependency_plan.py contract --infra-root .infra-dependency-recipe | jq -er .contract_sha256)
+            test "$contract" = "$BUILD_CONTRACT"
+            test ! -L ci && test ! -L ci/dependencies.json
+            jq -n --arg image "$IMAGE" --arg revision "$GITHUB_SHA" --arg inputs "$expected" --arg contract "$contract" '{schema:1,image:$image,source_revision:$revision,inputs_sha256:$inputs,build_contract_sha256:$contract,origin:"github-actions"}' > ci/dependencies.json
+            git add -- ci/dependencies.json
+            if git diff --cached --quiet; then exit 0; fi
+            git -c user.name=infra-release -c user.email=infra-release@users.noreply.github.com commit --quiet -m 'Pin verified parser dependency image'
+            if git -c credential.helper='!gh auth git-credential' push --quiet origin HEAD:main; then exit 0; fi
+            branch="infra/dependencies-${GITHUB_SHA:0:12}-${IMAGE##*:}"
+            git -c credential.helper='!gh auth git-credential' push --quiet origin "HEAD:refs/heads/$branch"
+            url=$(gh pr list --head "$branch" --state open --json url --jq '.[0].url // empty')
+            if [[ -z "$url" ]]; then
+              printf 'Pin verified dependency image %s from source %s.\n' "$IMAGE" "$GITHUB_SHA" > "$RUNNER_TEMP/dependency-pr.txt"
+              url=$(gh pr create --base main --head "$branch" --title 'Pin verified parser dependencies' --body-file "$RUNNER_TEMP/dependency-pr.txt")
+            fi
+            gh pr merge "$url" --auto --squash || gh pr merge "$url" --squash
+            exit 0
+          done
+          exit 1
