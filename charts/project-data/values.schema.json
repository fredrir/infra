{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "data"
  ],
  "properties": {
    "project": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,29}$"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "postgres": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "size",
            "image",
            "recovery"
          ],
          "properties": {
            "size": {
              "enum": [
                "10Gi",
                "40Gi",
                "100Gi"
              ]
            },
            "image": {
              "const": "docker.io/library/postgres@sha256:051f7b7b3abdd564d5d1bd1e8c4b9c1b6e77087d1dd22020ede611c096a272e0"
            },
            "recovery": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "rpoHours",
                "rtoHours"
              ],
              "properties": {
                "rpoHours": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 168
                },
                "rtoHours": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 168
                }
              }
            }
          }
        },
        "valkey": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "size",
            "image",
            "recovery"
          ],
          "properties": {
            "size": {
              "enum": [
                "10Gi",
                "40Gi",
                "100Gi"
              ]
            },
            "image": {
              "const": "docker.io/valkey/valkey@sha256:d2e18f3410b6f616de1417f570fa55261af2898b9c5b2cfb6781ce2373ea43d1"
            },
            "recovery": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "rpoHours",
                "rtoHours"
              ],
              "properties": {
                "rpoHours": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 168
                },
                "rtoHours": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 168
                }
              }
            }
          }
        }
      },
      "minProperties": 1
    }
  }
}
