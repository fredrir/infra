[Unit]
Description=Cloudflare tunnel connector for the llunde vhosts (ADR 017)

[Container]
ContainerName=llunde-cloudflared
EnvironmentFile=/run/secrets/llunde-tunnel.env
Exec=tunnel --no-autoupdate run
Image=docker.io/cloudflare/cloudflared@sha256:e39ee8da81ad5e05d77f38d2f51c60ca51bf2a8450ac3abab50c17fdb91d91bf
Network=host

[Service]
MemoryMax=256M
Restart=always

[Install]
WantedBy=default.target
