[Unit]
Description=Caddy public ingress (ADR 006)

[Container]
Image=ghcr.io/fredrir/llunde-caddy@sha256:4c9de100f63866a9e7efdfbb69a97902e62b14d577f2ceea818ef7973ef524ee
Network=host
Volume=/etc/llunde/caddy/Caddyfile:/etc/caddy/Caddyfile:ro
Volume=caddy-data:/data
Volume=caddy-config:/config

[Service]
Environment=REGISTRY_AUTH_FILE=/run/secrets/llunde-caddy-ghcr.json
MemoryMax=256M
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
