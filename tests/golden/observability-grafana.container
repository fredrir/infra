[Container]
ContainerName=observability-grafana
Environment=GF_AUTH_ANONYMOUS_ENABLED=false
Environment=GF_AUTH_ANONYMOUS_ORG_ROLE=Viewer
Environment=GF_AUTH_DISABLE_LOGIN_FORM=false
Environment=GF_AUTH_BASIC_ENABLED=false
Environment=GF_ANALYTICS_REPORTING_ENABLED=false
Environment=GF_SMTP_ENABLED=true
Environment=GF_SMTP_HOST=email-smtp.eu-north-1.amazonaws.com:587
Environment=GF_SMTP_FROM_ADDRESS=alerts@llunde.no
Environment=GF_SMTP_FROM_NAME=llunde alerts
EnvironmentFile=/run/secrets/observability-smtp.env
EnvironmentFile=/run/secrets/observability-grafana.env
Image=docker.io/grafana/grafana:13.2.1@sha256:f772d434e8fab0049deb2b1b30abd43342bcfca1537614aa8d36080232cf4283
Network=observability.network
PublishPort=0.0.0.0:3000:3000
Volume=/etc/llunde/observability/grafana/datasources.yaml:/etc/grafana/provisioning/datasources/datasources.yaml:ro
Volume=/etc/llunde/observability/grafana/dashboards.yaml:/etc/grafana/provisioning/dashboards/dashboards.yaml:ro
Volume=/etc/llunde/observability/grafana/alerting.yaml:/etc/grafana/provisioning/alerting/alerting.yaml:ro
Volume=/etc/llunde/observability/grafana/overview.json:/etc/grafana/dashboards/overview.json:ro
Volume=grafana-data:/var/lib/grafana:U

[Service]
MemoryMax=384M
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
