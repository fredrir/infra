{
	email fhansteen@gmail.com
	acme_dns cloudflare {env.CF_API_TOKEN}
}

api.llunde.no {
	encode gzip
@ops path /metrics* /health* /ready*
respond @ops 403
	reverse_proxy 127.0.0.1:8080
}

llunde.no {
	encode gzip
	reverse_proxy 127.0.0.1:8081
}

www.llunde.no {
	redir https://llunde.no{uri} permanent
}

http://:9101 {
	@scrape path /metrics /ready
	handle @scrape {
		reverse_proxy 127.0.0.1:8080
	}
	handle {
		respond 403
	}
}

http://:8085 {
	bind 127.0.0.1
	@nocf {
		not header_regexp CF-Connecting-IP .
	}
	handle @nocf {
		respond 400
	}
	@t_api_llunde_no host api.llunde.no
	handle @t_api_llunde_no {
		@ops_api_llunde_no path /metrics* /health* /ready*
		respond @ops_api_llunde_no 403
		reverse_proxy 127.0.0.1:8080 {
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-For {header.CF-Connecting-IP}
		}
	}

	@t_llunde_no host llunde.no
	handle @t_llunde_no {
		reverse_proxy 127.0.0.1:8081 {
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-For {header.CF-Connecting-IP}
		}
	}

@t_www_llunde_no host www.llunde.no
handle @t_www_llunde_no {
	redir https://llunde.no{uri} permanent
}

	handle {
		respond 404
	}
}
