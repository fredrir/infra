load("@gazelle//:def.bzl", "gazelle")

# gazelle:prefix github.com/fredrir/infra
# gazelle:exclude dist
# gazelle:exclude .infra

gazelle(name = "gazelle")

exports_files([
    "go.mod",
    "go.sum",
])

filegroup(
    name = "workflows",
    srcs = glob([".github/workflows/*.yml"]),
    visibility = ["//internal/policy:__pkg__"],
)

filegroup(
    name = "image_contract_data",
    srcs = glob(["images/**"]) + [
        ".bazelrc",
        ".bazelversion",
        "BUILD.bazel",
        "MODULE.bazel",
        "MODULE.bazel.lock",
        "go.mod",
        "go.sum",
        "pyproject.toml",
        "uv.lock",
        ":workflows",
        "//build:BUILD.bazel",
        "//build:dagger-embed.patch",
        "//build:toolchain.json",
        "//platform:components/backups/tools.Dockerfile",
    ],
    visibility = ["//internal/contracts:__pkg__"],
)

filegroup(
    name = "build_vm_metrics_data",
    srcs = [
        "ansible/inventory/production.yml",
        "//platform:components/observability/build-vm.yaml",
    ],
    visibility = ["//internal/contracts:__pkg__"],
)

filegroup(
    name = "renovate_pin_data",
    srcs = glob(["images/*/Containerfile"]) + [
        "renovate.json",
        "//build:runners.json",
    ],
    visibility = ["//internal/contracts:__pkg__"],
)

filegroup(
    name = "runner_routing_data",
    srcs = [
        ":workflows",
        "//build:runners.json",
    ],
    visibility = ["//internal/reconcile:__pkg__"],
)

filegroup(
    name = "reconciliation_action_data",
    srcs = [
        ".github/actions/setup-reconciliation-cli/action.yml",
        ".github/actions/setup-reconciliation/action.yml",
    ],
    visibility = ["//internal/reconcile:__pkg__"],
)

filegroup(
    name = "publishing_data",
    srcs = glob([".github/*-ruleset.json"]) + ["//build:publisher.json"],
    visibility = ["//internal/reconcile:__pkg__"],
)

filegroup(
    name = "host_play_data",
    srcs = glob([
        "ansible/*.yml",
        "ansible/inventory/*.yml",
        "ansible/roles/*/defaults/*.yml",
        "ansible/roles/*/handlers/*.yml",
        "ansible/roles/*/tasks/*.yml",
        "ansible/roles/*/templates/*",
    ]),
    visibility = ["//internal/reconcile:__pkg__"],
)
