load("@gazelle//:def.bzl", "gazelle")

# gazelle:prefix github.com/fredrir/infra
# gazelle:exclude dist
# gazelle:exclude .infra

gazelle(name = "gazelle")

exports_files([
    "go.mod",
    "go.sum",
])

filegroup(
    name = "workflows",
    srcs = glob([".github/workflows/*.yml"]),
    visibility = [
        "//internal/cli:__pkg__",
        "//internal/policy:__pkg__",
    ],
)

filegroup(
    name = "image_contract_data",
    srcs = glob(["images/**"]) + [
        ".bazelrc",
        ".bazelversion",
        "BUILD.bazel",
        "MODULE.bazel",
        "MODULE.bazel.lock",
        "go.mod",
        "go.sum",
        "pyproject.toml",
        "uv.lock",
        ":workflows",
        "//build:BUILD.bazel",
        "//build:dagger-embed.patch",
        "//build:toolchain.json",
        "//platform:components/backups/tools.Dockerfile",
    ],
    visibility = ["//internal/contracts:__pkg__"],
)

filegroup(
    name = "build_vm_metrics_data",
    srcs = [
        "ansible/inventory/production.yml",
        "//platform:components/observability/build-vm.yaml",
    ],
    visibility = ["//internal/contracts:__pkg__"],
)

filegroup(
    name = "host_firewall_data",
    srcs = [
        "ansible/roles/firewall/defaults/main.yml",
        "ansible/roles/firewall/templates/platform-host.nft.j2",
        "ansible/roles/k3s/defaults/main.yml",
    ],
    visibility = ["//internal/contracts:__pkg__"],
)

filegroup(
    name = "node_local_dns_data",
    srcs = [
        "ansible/roles/k3s/templates/config.yaml.j2",
        "renovate.json",
        "//platform:versions.yaml",
    ],
    visibility = ["//internal/contracts:__pkg__"],
)

filegroup(
    name = "node_registration_data",
    srcs = ["ansible/inventory/production.yml"],
    visibility = ["//internal/policy:__pkg__"],
)

filegroup(
    name = "tailnet_policy_data",
    srcs = ["tailscale/policy.hujson"],
    visibility = ["//internal/contracts:__pkg__"],
)

filegroup(
    name = "renovate_pin_data",
    srcs = glob(["images/*/Containerfile"]) + [
        "renovate.json",
        "//build:runners.json",
    ],
    visibility = ["//internal/contracts:__pkg__"],
)

filegroup(
    name = "host_secret_data",
    srcs = glob([
        "ansible/roles/*/defaults/*.yml",
        "ansible/roles/*/files/*.sops.yaml",
        "ansible/roles/*/tasks/*.yml",
        "secrets/*.yaml",
    ]) + [
        ".sops.yaml",
        "ansible/roles/gatus/templates/config.yaml.j2",
    ],
    visibility = ["//internal/contracts:__pkg__"],
)

filegroup(
    name = "runner_routing_data",
    srcs = [
        ":workflows",
        "//build:runners.json",
    ],
    visibility = ["//internal/reconcile:__pkg__"],
)

filegroup(
    name = "cli_input_data",
    srcs = [".github/actions/cli-inputs/action.yml"],
    visibility = ["//internal/contracts:__pkg__"],
)

filegroup(
    name = "reconciliation_action_data",
    srcs = [
        ".github/actions/setup-reconciliation-cli/action.yml",
        ".github/actions/setup-reconciliation/action.yml",
    ],
    visibility = ["//internal/reconcile:__pkg__"],
)

filegroup(
    name = "publishing_data",
    srcs = glob([".github/*-ruleset.json"]) + ["//build:publisher.json"],
    visibility = ["//internal/reconcile:__pkg__"],
)

filegroup(
    name = "web_flow_key",
    srcs = ["keys/github-web-flow.asc"],
    visibility = ["//internal/reconcile:__pkg__"],
)

filegroup(
    name = "host_play_data",
    srcs = glob([
        "ansible/*.yml",
        "ansible/inventory/*.yml",
        "ansible/roles/*/defaults/*.yml",
        "ansible/roles/*/handlers/*.yml",
        "ansible/roles/*/tasks/*.yml",
        "ansible/roles/*/templates/*",
    ]),
    visibility = ["//internal/reconcile:__pkg__"],
)

filegroup(
    name = "reconciler_role_data",
    srcs = glob(["ansible/roles/reconciler/**"]),
    visibility = ["//internal/reconciler:__pkg__"],
)

filegroup(
    name = "dev_hosts_data",
    srcs = ["dev/hosts/hosts.yaml"],
    visibility = ["//internal/dev:__pkg__"],
)
