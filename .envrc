use doppler
PATH_add .cache/dev/bin
PATH_add .cache/dev/tools
PATH_add .venv/bin
export INFRA_TOOL_CACHE=$PWD/.cache/dev/tools
kubeconfigs=$(find ~/.kube -maxdepth 2 -name '*.yaml' -type f 2>/dev/null | sort | paste -sd: -)
if [ -n "$kubeconfigs" ]; then
  export KUBECONFIG="$kubeconfigs"
fi
if [ "$(docker inspect --format '{{.State.Running}}' infra-dagger-dev 2>/dev/null)" = true ]; then
  export _EXPERIMENTAL_DAGGER_RUNNER_HOST=docker-container://infra-dagger-dev
fi
export SOPS_AGE_KEY_FILE="$HOME/.config/age/keys.txt"
