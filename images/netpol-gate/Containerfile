FROM docker.io/library/golang:1.27.1-alpine@sha256:8a5910f31396cd4d89662f56c68b3ae31d374308270a1c3bd96672ee5ed43414 AS build
WORKDIR /src
COPY cmd/netpol-gate/main.go cmd/netpol-gate/
COPY internal/netpolgate/gate.go internal/netpolgate/run.go internal/netpolgate/
RUN go mod init github.com/fredrir/infra \
    && CGO_ENABLED=0 go build -trimpath -ldflags '-s -w' -o /out/netpol-gate ./cmd/netpol-gate

FROM docker.io/library/alpine:3.24.2@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
RUN apk upgrade --no-cache
COPY --from=build /out/netpol-gate /usr/local/bin/netpol-gate
USER 65534:65534
ENTRYPOINT ["/usr/local/bin/netpol-gate"]
