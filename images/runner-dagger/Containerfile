FROM golang:1.27.1-bookworm@sha256:69a7b9788769bec032d238959b61854e9ae87f57be9029ec04e9885fabf99195 AS tools
ENV CGO_ENABLED=0
ENV GOTOOLCHAIN=local
ENV GOWORK=off
ENV GOMAXPROCS=2
ENV GOMEMLIMIT=1GiB
ENV GOFLAGS="-mod=readonly -p=2"
COPY images/runner-dagger/dependencies.patch /tmp/dependencies.patch
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    mkdir -p /src/dagger /out \
    && curl --fail --silent --show-error --location --max-time 120 --output /tmp/source.tar.gz https://codeload.github.com/dagger/dagger/tar.gz/refs/tags/v0.21.9 \
    && printf '%s  %s\n' 652fffab225340df36ea4f65eded61628a9cf5f1dd2ac2f667aadaa5d84eb430 /tmp/source.tar.gz | sha256sum --check --strict \
    && tar -xzf /tmp/source.tar.gz --strip-components=1 -C /src/dagger \
    && cd /src/dagger \
    && git apply /tmp/dependencies.patch \
    && go build -trimpath -buildvcs=false -ldflags="-s -w -X github.com/dagger/dagger/engine.Version=v0.21.9 -X github.com/dagger/dagger/engine.Tag=v0.21.9" -o /out/dagger ./cmd/dagger \
    && rm -rf /src/dagger /tmp/source.tar.gz

FROM ghcr.io/actions/actions-runner:2.337.0@sha256:e5496277be5d09bc968b3d64911b74e219ac4a3f2edce956a3ecf9271bea1ef4
USER root
RUN rm -rf /usr/bin/containerd /usr/bin/containerd-shim-runc-v2 /usr/bin/ctr \
        /usr/bin/docker /usr/bin/docker-init /usr/bin/docker-proxy /usr/bin/dockerd /usr/bin/runc \
        /usr/local/lib/docker \
        /home/runner/externals/node20/lib/node_modules /home/runner/externals/node24/lib/node_modules \
        /home/runner/externals/node20/bin/npm /home/runner/externals/node20/bin/npx /home/runner/externals/node20/bin/corepack \
        /home/runner/externals/node24/bin/npm /home/runner/externals/node24/bin/npx /home/runner/externals/node24/bin/corepack
COPY --from=tools /out/dagger /usr/local/bin/dagger
COPY --chmod=755 .infra-artifacts/infra /usr/local/bin/infra
RUN ln -s /usr/local/bin/infra /usr/local/bin/infra-runner-hook
ENV _EXPERIMENTAL_DAGGER_CLI_BIN=/usr/local/bin/dagger
USER runner
WORKDIR /home/runner
