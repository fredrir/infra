FROM ghcr.io/fredrir/infra-runner-check@sha256:d1b840893228c7adb52b32d994c9cf9a11d46912a62507d0b93f673f2270a0e9
USER root
COPY images/runner-check/ubuntu.sources /etc/apt/sources.list.d/ubuntu.sources
RUN apt-get update -o APT::Update::Error-Mode=any \
    && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y \
    && rm -rf /var/lib/apt/lists/*
COPY --chmod=0555 .infra-artifacts/infra /usr/local/bin/infra
COPY build/cli-release.json /opt/infra-cli-release.json
ENV INFRA_TOOL_CACHE=/root/.cache/infra/tools
RUN digest=$(jq -er '.sha256 | select(test("^[a-f0-9]{64}$"))' /opt/infra-cli-release.json) \
    && printf '%s  %s\n' "$digest" /usr/local/bin/infra | sha256sum --check --strict \
    && install -d -m0700 "/root/.cache/infra/bin/$digest" "$INFRA_TOOL_CACHE" \
    && install -m0555 /usr/local/bin/infra "/root/.cache/infra/bin/$digest/infra" \
    && RUNNER_TEMP=/tmp infra ci install-tools gh cosign
RUN --network=none RUNNER_TEMP=/tmp infra ci install-tools gh cosign
ENV PATH=/root/.cache/infra/tools:/usr/local/bin:/opt/tools:/opt/venv/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin
