FROM golang:1.27.2-bookworm@sha256:5cf287a799e6b94384bad13d16b14904c531f51ba65792237e122ce42b392f61 AS tools
ENV CGO_ENABLED=0
ENV GOTOOLCHAIN=local
ENV GOWORK=off
ARG GO_BUILD_PARALLELISM=2
ARG GO_BUILD_MEMORY_LIMIT=1GiB
ENV GOMAXPROCS=${GO_BUILD_PARALLELISM}
ENV GOMEMLIMIT=${GO_BUILD_MEMORY_LIMIT}
ENV GOFLAGS="-mod=readonly -p=${GO_BUILD_PARALLELISM}"
COPY images/runner-check/patches/actionlint.patch /tmp/actionlint.patch
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    mkdir -p /src/actionlint /out \
    && curl --fail --silent --show-error --location --max-time 120 --output /tmp/source.tar.gz https://codeload.github.com/rhysd/actionlint/tar.gz/refs/tags/v1.7.12 \
    && printf '%s  %s\n' 454800bd4f854592bcfe79b161f71d56e35940eb7016e48a26dd356adc9d400a /tmp/source.tar.gz | sha256sum --check --strict \
    && tar -xzf /tmp/source.tar.gz --strip-components=1 -C /src/actionlint \
    && cd /src/actionlint \
    && git apply /tmp/actionlint.patch \
    && go build -trimpath -buildvcs=false -ldflags="-s -w -X github.com/rhysd/actionlint.version=1.7.12" -o /out/actionlint ./cmd/actionlint \
    && rm -rf /src/actionlint /tmp/source.tar.gz
COPY images/runner-check/patches/kustomize.patch /tmp/kustomize.patch
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    mkdir -p /src/kustomize /out \
    && curl --fail --silent --show-error --location --max-time 120 --output /tmp/source.tar.gz https://codeload.github.com/kubernetes-sigs/kustomize/tar.gz/refs/tags/kustomize/v5.8.1 \
    && printf '%s  %s\n' 4ea5a974c46ad6efcde4fd9c339ab1bd278a80b6872dda2d1a366936e4638475 /tmp/source.tar.gz | sha256sum --check --strict \
    && tar -xzf /tmp/source.tar.gz --strip-components=1 -C /src/kustomize \
    && cd /src/kustomize/kustomize \
    && git apply /tmp/kustomize.patch \
    && go build -trimpath -buildvcs=false -ldflags="-s -w -X sigs.k8s.io/kustomize/api/provenance.version=v5.8.1" -o /out/kustomize . \
    && rm -rf /src/kustomize /tmp/source.tar.gz
COPY images/runner-check/patches/sops.patch /tmp/sops.patch
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    mkdir -p /src/sops /out \
    && curl --fail --silent --show-error --location --max-time 120 --output /tmp/source.tar.gz https://codeload.github.com/getsops/sops/tar.gz/refs/tags/v3.13.3 \
    && printf '%s  %s\n' 49811c5ed80f6b4d4e98cef98e3f7378406aa692fd773dfb72ad1b4dfb940448 /tmp/source.tar.gz | sha256sum --check --strict \
    && tar -xzf /tmp/source.tar.gz --strip-components=1 -C /src/sops \
    && cd /src/sops \
    && git apply /tmp/sops.patch \
    && go build -trimpath -buildvcs=false -ldflags="-s -w -X github.com/getsops/sops/v3/version.Version=3.13.3" -o /out/sops ./cmd/sops \
    && rm -rf /src/sops /tmp/source.tar.gz
COPY images/runner-check/patches/tofu.patch /tmp/tofu.patch
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    mkdir -p /src/tofu /out \
    && curl --fail --silent --show-error --location --max-time 120 --output /tmp/source.tar.gz https://codeload.github.com/opentofu/opentofu/tar.gz/refs/tags/v1.12.6 \
    && printf '%s  %s\n' d6b49908a66ad277d7de33e9a218ae11b956cd094e39c82300b9b75cac2479ba /tmp/source.tar.gz | sha256sum --check --strict \
    && tar -xzf /tmp/source.tar.gz --strip-components=1 -C /src/tofu \
    && cd /src/tofu \
    && git apply /tmp/tofu.patch \
    && go test ./internal/tracing/traceattrs \
    && go build -trimpath -buildvcs=false -ldflags="-s -w -X github.com/opentofu/opentofu/version.dev=no" -o /out/tofu ./cmd/tofu \
    && rm -rf /src/tofu /tmp/source.tar.gz
COPY images/runner-check/patches/kubectl.patch /tmp/kubectl.patch
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    mkdir -p /src/kubectl /out \
    && curl --fail --silent --show-error --location --max-time 120 --output /tmp/source.tar.gz https://codeload.github.com/kubernetes/kubernetes/tar.gz/refs/tags/v1.36.5 \
    && printf '%s  %s\n' e768e95c34605f3829116736e189f46af54c6416c3229cadd7308e524202735b /tmp/source.tar.gz | sha256sum --check --strict \
    && tar -xzf /tmp/source.tar.gz --strip-components=1 -C /src/kubectl \
    && cd /src/kubectl \
    && git apply /tmp/kubectl.patch \
    && go build -trimpath -buildvcs=false -ldflags="-s -w -X k8s.io/client-go/pkg/version.gitVersion=v1.36.5 -X k8s.io/component-base/version.gitVersion=v1.36.5" -o /out/kubectl ./cmd/kubectl \
    && rm -rf /src/kubectl /tmp/source.tar.gz
COPY images/runner-check/patches/helm.patch /tmp/helm.patch
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    mkdir -p /src/helm /out \
    && curl --fail --silent --show-error --location --max-time 120 --output /tmp/source.tar.gz https://codeload.github.com/helm/helm/tar.gz/refs/tags/v4.3.0 \
    && printf '%s  %s\n' c9c930efa3abf03c331da421db81d61fb942218c7a7b80a8c0f0132d79fb5f62 /tmp/source.tar.gz | sha256sum --check --strict \
    && tar -xzf /tmp/source.tar.gz --strip-components=1 -C /src/helm \
    && cd /src/helm \
    && git apply /tmp/helm.patch \
    && go build -trimpath -buildvcs=false -ldflags="-s -w -X helm.sh/helm/v4/internal/version.version=v4.3.0" -o /out/helm ./cmd/helm \
    && rm -rf /src/helm /tmp/source.tar.gz
COPY images/runner-check/patches/yq.patch /tmp/yq.patch
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    mkdir -p /src/yq /out \
    && curl --fail --silent --show-error --location --max-time 120 --output /tmp/source.tar.gz https://codeload.github.com/mikefarah/yq/tar.gz/refs/tags/v4.54.1 \
    && printf '%s  %s\n' 0cec36e7035dd56c508bda56245cbd71e4495d2317bc2528165c4162bce79335 /tmp/source.tar.gz | sha256sum --check --strict \
    && tar -xzf /tmp/source.tar.gz --strip-components=1 -C /src/yq \
    && cd /src/yq \
    && git apply /tmp/yq.patch \
    && go build -trimpath -buildvcs=false -ldflags="-s -w" -o /out/yq . \
    && rm -rf /src/yq /tmp/source.tar.gz
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    mkdir -p /src/age /out \
    && curl --fail --silent --show-error --location --max-time 120 --output /tmp/source.tar.gz https://codeload.github.com/FiloSottile/age/tar.gz/refs/tags/v1.3.2 \
    && printf '%s  %s\n' b07c28c6c4bdafa272073a310b75bc22c49da8904585a89c30e5ca4233e63843 /tmp/source.tar.gz | sha256sum --check --strict \
    && tar -xzf /tmp/source.tar.gz --strip-components=1 -C /src/age \
    && cd /src/age \
    && go build -trimpath -buildvcs=false -ldflags="-s -w -X main.Version=v1.3.2" -o /out/ ./cmd/age ./cmd/age-keygen \
    && rm -rf /src/age /tmp/source.tar.gz

FROM ghcr.io/actions/actions-runner:2.337.0@sha256:e5496277be5d09bc968b3d64911b74e219ac4a3f2edce956a3ecf9271bea1ef4
USER root
COPY images/runner-check/ubuntu.sources /etc/apt/sources.list.d/ubuntu.sources
RUN apt-get update -o APT::Update::Error-Mode=any \
    && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        bash ca-certificates coreutils curl git jq openssh-client openssl python3 python3-venv sqlite3 zstd \
    && rm -rf /var/lib/apt/lists/*
RUN rm -rf /usr/bin/containerd /usr/bin/containerd-shim-runc-v2 /usr/bin/ctr \
        /usr/bin/docker /usr/bin/docker-init /usr/bin/docker-proxy /usr/bin/dockerd /usr/bin/runc \
        /usr/local/lib/docker \
        /home/runner/externals/node20/lib/node_modules /home/runner/externals/node24/lib/node_modules \
        /home/runner/externals/node20/bin/npm /home/runner/externals/node20/bin/npx /home/runner/externals/node20/bin/corepack \
        /home/runner/externals/node24/bin/npm /home/runner/externals/node24/bin/npx /home/runner/externals/node24/bin/corepack
COPY --chmod=755 .infra-artifacts/infra /usr/local/bin/infra
COPY --from=tools /out/ /opt/tools/
RUN RUNNER_TEMP=/opt infra ci install-tools uv \
    && chmod 755 /opt/tools
ENV PATH=/usr/local/bin:/opt/tools:/opt/venv/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin
ENV UV_PYTHON_DOWNLOADS=never
ENV UV_PROJECT_ENVIRONMENT=/opt/venv
ENV UV_LINK_MODE=copy
COPY pyproject.toml uv.lock /tmp/pins/
RUN cd /tmp/pins && uv sync --frozen --group ci --no-install-project --compile-bytecode \
    && chmod -R a+rX /opt/venv \
    && rm -rf /tmp/pins /root/.cache
ENV RUNNER_ALLOW_RUNASROOT=1
WORKDIR /home/runner
RUN --mount=type=bind,source=images/runner-check/verify.sh,target=/tmp/verify.sh /tmp/verify.sh
