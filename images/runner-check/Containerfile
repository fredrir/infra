FROM ghcr.io/actions/actions-runner:2.337.0@sha256:e5496277be5d09bc968b3d64911b74e219ac4a3f2edce956a3ecf9271bea1ef4
USER root
COPY images/runner-check/ubuntu.sources /etc/apt/sources.list.d/ubuntu.sources
RUN apt-get update -o APT::Update::Error-Mode=any \
    && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        bash ca-certificates coreutils curl git jq openssh-client python3 python3-venv sqlite3 zstd \
    && rm -rf /var/lib/apt/lists/*
COPY --chmod=755 .infra-artifacts/infra /usr/local/bin/infra
RUN RUNNER_TEMP=/opt infra ci install-tools actionlint age age-keygen sops uv tofu helm kubectl kustomize yq \
    && chmod 755 /opt/tools \
    && ln -s /usr/local/bin/infra /usr/local/bin/infra-runner-hook
ENV PATH=/usr/local/bin:/opt/tools:/opt/venv/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin
ENV UV_PYTHON_DOWNLOADS=never
ENV UV_PROJECT_ENVIRONMENT=/opt/venv
ENV UV_LINK_MODE=copy
COPY pyproject.toml uv.lock /tmp/pins/
RUN cd /tmp/pins && uv sync --frozen --group ci --no-install-project \
    && chmod -R a+rX /opt/venv \
    && rm -rf /tmp/pins /root/.cache
ENV RUNNER_ALLOW_RUNASROOT=1
WORKDIR /home/runner
