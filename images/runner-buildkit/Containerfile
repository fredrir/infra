FROM docker.io/library/golang:1.27.1-alpine@sha256:cf6fca6641884b8433441b2b0652976f975e1d0fdd26d177eaaf8596087f3125 AS buildkit
RUN apk add --no-cache build-base git libseccomp-dev libseccomp-static pkgconf
WORKDIR /src
RUN git init -q . \
    && git remote add origin https://github.com/moby/buildkit.git \
    && git fetch -q --depth 1 origin 63956db2950b78a2ab6f2aeef4672215fd969ca9 \
    && git checkout -q FETCH_HEAD
RUN go get github.com/moby/go-archive@v0.3.3 \
    && go mod tidy \
    && go mod vendor
RUN CGO_ENABLED=0 go build -trimpath -ldflags '-X github.com/moby/buildkit/version.Version=v0.33.0 -X github.com/moby/buildkit/version.Revision=63956db2950b78a2ab6f2aeef4672215fd969ca9 -X github.com/moby/buildkit/version.Package=github.com/moby/buildkit' -o /out/buildctl ./cmd/buildctl
RUN CGO_ENABLED=1 go build -trimpath -tags 'osusergo netgo static_build seccomp' -ldflags '-extldflags -static -X github.com/moby/buildkit/version.Version=v0.33.0 -X github.com/moby/buildkit/version.Revision=63956db2950b78a2ab6f2aeef4672215fd969ca9 -X github.com/moby/buildkit/version.Package=github.com/moby/buildkit' -o /out/buildkitd ./cmd/buildkitd
RUN cp examples/buildctl-daemonless/buildctl-daemonless.sh /out/buildctl-daemonless.sh

FROM docker.io/library/golang:1.27.1-alpine@sha256:cf6fca6641884b8433441b2b0652976f975e1d0fdd26d177eaaf8596087f3125 AS runc
RUN apk add --no-cache build-base git libseccomp-dev libseccomp-static pkgconf
WORKDIR /src
RUN git init -q . \
    && git remote add origin https://github.com/opencontainers/runc.git \
    && git fetch -q --depth 1 origin 40c7c718c9431cd90ab0970ee52d47c4cb511e06 \
    && git checkout -q FETCH_HEAD
RUN go get golang.org/x/net@v0.59.0 \
    && go mod tidy \
    && go mod vendor
RUN CGO_ENABLED=1 go build -trimpath -tags 'apparmor seccomp netgo cgo static_build osusergo' -ldflags '-extldflags -static -X main.version=1.5.1 -X main.gitCommit=40c7c718c9431cd90ab0970ee52d47c4cb511e06' -o /out/buildkit-runc ./

FROM ghcr.io/actions/actions-runner:2.337.0@sha256:e5496277be5d09bc968b3d64911b74e219ac4a3f2edce956a3ecf9271bea1ef4
USER root
RUN sed -i 's|^URIs: http://|URIs: https://|' /etc/apt/sources.list.d/ubuntu.sources \
    && apt-get update -o APT::Update::Error-Mode=any \
    && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y \
    && apt-get install -y --no-install-recommends jq \
    && rm -rf /var/lib/apt/lists/*
RUN rm -rf /usr/bin/containerd /usr/bin/containerd-shim-runc-v2 /usr/bin/ctr \
        /usr/bin/docker /usr/bin/docker-init /usr/bin/docker-proxy /usr/bin/dockerd /usr/bin/runc \
        /usr/local/lib/docker \
        /home/runner/externals/node20/lib/node_modules/npm /home/runner/externals/node20/bin/npm /home/runner/externals/node20/bin/npx \
        /home/runner/externals/node24/lib/node_modules/npm /home/runner/externals/node24/bin/npm /home/runner/externals/node24/bin/npx
COPY --from=buildkit /out/buildctl /out/buildkitd /out/buildctl-daemonless.sh /usr/local/bin/
COPY --from=runc /out/buildkit-runc /usr/local/bin/buildkit-runc
ENV RUNNER_ALLOW_RUNASROOT=1
ENV BUILDKITD_FLAGS="--oci-worker=true --containerd-worker=false --oci-worker-snapshotter=native --oci-worker-binary=/usr/local/bin/buildkit-runc"
WORKDIR /home/runner
