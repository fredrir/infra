module(name = "infra")

bazel_dep(name = "rules_go", version = "0.63.0")
bazel_dep(name = "gazelle", version = "0.54.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.27.1")
go_sdk.nogo(
    includes = ["//:__subpackages__"],
    nogo = "@rules_go//:tools_nogo",
)

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
go_deps.module(
    indirect = True,
    path = "golang.org/x/tools",
    sum = "h1:c2ifzfcuY7L90lZ2aKd8S4K2NpASF08SZx9ZuJkHmSU=",
    version = "v0.50.0",
)
go_deps.module_override(
    patch_strip = 1,
    patches = ["//build:dagger-embed.patch"],
    path = "dagger.io/dagger",
)
go_deps.gazelle_override(
    build_file_generation = "clean",
    directives = ["gazelle:proto disable_global"],
    path = "cel.dev/cel-go",
)
use_repo(go_deps, "com_github_aws_aws_sdk_go_v2", "com_github_klauspost_compress", "com_github_pelletier_go_toml_v2", "com_github_spf13_cobra", "dev_cel_cel_go", "in_yaml_go_yaml_v3", "io_dagger_dagger", "io_k8s_apimachinery", "io_k8s_sigs_kustomize_api", "io_k8s_sigs_kustomize_kyaml", "org_golang_x_sync")
