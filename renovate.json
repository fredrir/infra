{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "enabledManagers": [
    "github-actions",
    "dockerfile",
    "flux",
    "terraform",
    "pep621",
    "nix",
    "custom.regex"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Containerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( extractVersion=(?<extractVersion>\\S+))?\\nARG \\S+_VERSION=(?<currentValue>\\S+)"
      ]
    }
  ],
  "automerge": false,
  "dependencyDashboard": true,
  "prConcurrentLimit": 3,
  "rangeStrategy": "pin",
  "packageRules": [
    {
      "matchManagers": ["pep621"],
      "matchDepNames": ["python"],
      "enabled": false
    },
    {
      "matchDatasources": ["docker"],
      "pinDigests": true
    },
    {
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "matchManagers": ["terraform"],
      "groupName": "tofu providers"
    },
    {
      "matchManagers": ["terraform"],
      "matchDepTypes": ["required_version"],
      "enabled": false
    },
    {
      "matchManagers": ["custom.regex"],
      "groupName": "runner tools",
      "prBodyNotes": ["Update the matching sha256 in the Containerfile before merging."]
    }
  ],
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  }
}
