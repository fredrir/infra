filegroup(
    name = "policy_testdata",
    srcs = glob([
        "clusters/production/flux-system/*.yaml",
        "components/**/*.yaml",
        "components/object-store/**",
        "projects/**/*.yaml",
    ]) + ["versions.yaml"],
    visibility = ["//internal/policy:__pkg__"],
)

exports_files([
    "components/backups/tools.Dockerfile",
    "components/object-store/pki/ca.crt",
    "components/observability/build-vm.yaml",
    "versions.yaml",
])

exports_files(
    ["components/policy/reconciliation.yaml"],
    visibility = ["//internal/reconcile:__pkg__"],
)

filegroup(
    name = "promotion_testdata",
    srcs = glob([
        "components/**",
        "projects/**",
    ]),
    visibility = ["//internal/platformops:__pkg__"],
)

filegroup(
    name = "arc_chart_data",
    srcs = glob(["components/**/*.yaml"]),
    visibility = ["//internal/contracts:__pkg__"],
)

filegroup(
    name = "sops_data",
    srcs = glob(["**/*.sops.yaml"]),
    visibility = ["//internal/contracts:__pkg__"],
)

filegroup(
    name = "renovate_pin_data",
    srcs = ["versions.yaml"] + glob(["components/object-store/*.yaml"]),
    visibility = ["//:__pkg__"],
)
