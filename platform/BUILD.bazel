filegroup(
    name = "policy_testdata",
    srcs = glob([
        "clusters/production/flux-system/*.yaml",
        "clusters/production/root.yaml",
        "components/**/*.yaml",
        "components/bazel-cache/nginx.conf",
        "components/object-store/**",
        "components/object-store-trust/**",
        "projects/**/*.yaml",
    ]) + ["versions.yaml"],
    visibility = ["//internal/policy:__pkg__"],
)

exports_files([
    "components/backups/tools.Dockerfile",
    "components/object-store-trust/ca.crt",
    "components/observability/build-vm.yaml",
    "versions.yaml",
])

exports_files(
    ["components/policy/reconciliation.yaml"],
    visibility = ["//internal/reconcile:__pkg__"],
)

filegroup(
    name = "promotion_testdata",
    srcs = glob([
        "components/**",
        "projects/**",
    ]),
    visibility = ["//internal/platformops:__pkg__"],
)

filegroup(
    name = "arc_chart_data",
    srcs = glob(["components/**/*.yaml"]),
    visibility = ["//internal/contracts:__pkg__"],
)

filegroup(
    name = "sops_data",
    srcs = glob(["**/*.sops.yaml"]),
    visibility = ["//internal/contracts:__pkg__"],
)

filegroup(
    name = "s3_filter_module",
    srcs = [
        "components/object-store/filtertest/go.mod",
        "components/object-store/filtertest/s3-filter.caddyfile.sha256",
        "components/object-store/s3-filter.caddyfile",
    ],
    visibility = ["//internal/contracts:__pkg__"],
)

filegroup(
    name = "renovate_pin_data",
    srcs = ["versions.yaml"] + glob(["components/object-store/*.yaml"]),
    visibility = ["//:__pkg__"],
)

filegroup(
    name = "bazel_cache_data",
    srcs = glob(["components/bazel-cache/**"]),
    visibility = ["//internal/contracts:__pkg__"],
)

filegroup(
    name = "flux_artifacts_data",
    srcs = glob(["clusters/production/**/*.yaml"]),
    visibility = ["//internal/contracts:__pkg__"],
)
