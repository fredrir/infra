        {
          "accessKey": "${TOOLCHAINS_UPLOAD_ACCESS_KEY_ID}",
          "secretKey": "${TOOLCHAINS_UPLOAD_SECRET_ACCESS_KEY}"
        }
      ],
      "name": "toolchains-upload"
