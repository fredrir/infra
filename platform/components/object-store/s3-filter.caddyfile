{
	admin off
	persist_config off
	auto_https off
	servers {
		protocols h1 h2
	}
	log {
		output stderr
		format json
		level WARN
	}
}

(proxy) {
	reverse_proxy {args[0]} 127.0.0.1:8334 {
		flush_interval -1
	}
}

:8333 {
	tls /etc/seaweedfs/tls/s3.crt /etc/seaweedfs/tls/s3.key {
		protocols tls1.2
	}
	@malformed expression `{http.request.uri.query}.matches("[;]|%([^0-9A-Fa-f]|[0-9A-Fa-f]([^0-9A-Fa-f]|$)|$)")`
	@provisioner expression `{http.request.header.Authorization}.matches("^AWS4-HMAC-SHA256 Credential={$PROVISIONER_ACCESS_KEY_ID}/[^,]*, ?SignedHeaders=[^,]*, ?Signature=[0-9a-f]{64}$")`
	@read method GET HEAD
	@write expression <<CEL
		{http.request.header.X-Amz-Object-Lock-Mode} == ""
		&& {http.request.header.X-Amz-Object-Lock-Retain-Until-Date} == ""
		&& {http.request.header.X-Amz-Object-Lock-Legal-Hold} == ""
		&& {http.request.header.X-Amz-Bypass-Governance-Retention} == ""
		&& !{http.request.header.Content-Type}.matches("(?i)^ *multipart/form-data")
		&& {http.request.uri.query}.matches("^((uploads=?|delete=?|uploadId=[A-Za-z0-9._~-]+|partNumber=[1-9][0-9]{0,4}|x-id=[A-Za-z]+)(&(uploads=?|delete=?|uploadId=[A-Za-z0-9._~-]+|partNumber=[1-9][0-9]{0,4}|x-id=[A-Za-z]+))*)?$")
		&& !{http.request.uri.query}.matches("(^|&)uploads(=[^&]*)?&(.*&)?uploads(=|&|$)")
		&& !{http.request.uri.query}.matches("(^|&)delete(=[^&]*)?&(.*&)?delete(=|&|$)")
		&& !{http.request.uri.query}.matches("(^|&)uploadId=.*&uploadId=")
		&& !{http.request.uri.query}.matches("(^|&)partNumber=.*&partNumber=")
		&& !{http.request.uri.query}.matches("(^|&)x-id=.*&x-id=")
		&& (
			(
				{http.request.method} == "PUT"
				&& {http.request.uri.path}.matches("^/[^/]+/.+")
				&& !{http.request.uri.query}.matches("(^|&)(uploads|delete)([=&]|$)")
				&& {http.request.uri.query}.matches("(^|&)partNumber=") == {http.request.uri.query}.matches("(^|&)uploadId=")
			) || (
				{http.request.method} == "POST"
				&& {http.request.uri.path}.matches("^/[^/]+/.+")
				&& !{http.request.uri.query}.matches("(^|&)(delete([=&]|$)|partNumber=)")
				&& {http.request.uri.query}.matches("(^|&)uploads([=&]|$)") != {http.request.uri.query}.matches("(^|&)uploadId=")
			) || (
				{http.request.method} == "POST"
				&& {http.request.uri.path}.matches("^/[^/]+/?$")
				&& {http.request.uri.query}.matches("(^|&)delete([=&]|$)")
				&& !{http.request.uri.query}.matches("(^|&)(uploads([=&]|$)|uploadId=|partNumber=)")
			) || (
				{http.request.method} == "DELETE"
				&& {http.request.uri.path}.matches("^/[^/]+/.+")
				&& !{http.request.uri.query}.matches("(^|&)(uploads([=&]|$)|delete([=&]|$)|partNumber=)")
			)
		)
		CEL
	route {
		respond @malformed "malformed query" 400
		import proxy @provisioner
		import proxy @read
		import proxy @write
		respond "denied by the object store filter" 403
	}
}
