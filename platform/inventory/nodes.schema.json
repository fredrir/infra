{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "cluster", "nodes", "candidates"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "apiName", "podCIDR", "serviceCIDR", "k3sVersion"],
      "properties": {
        "name": {
          "const": "production"
        },
        "apiName": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*$"
        },
        "podCIDR": {
          "type": "string",
          "minLength": 1
        },
        "serviceCIDR": {
          "type": "string",
          "minLength": 1
        },
        "k3sVersion": {
          "const": "v1.36.3+k3s1"
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      }
    }
  },
  "$defs": {
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vCPU", "memoryGiB", "diskGiB"],
      "properties": {
        "vCPU": {
          "type": "integer",
          "minimum": 1
        },
        "memoryGiB": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "diskGiB": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified", "production", "ci", "stateful", "critical"],
      "properties": {
        "verified": {
          "type": "boolean"
        },
        "production": {
          "type": "boolean"
        },
        "ci": {
          "type": "boolean"
        },
        "stateful": {
          "type": "boolean"
        },
        "critical": {
          "type": "boolean"
        }
      }
    },
    "enrollment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sshAddress", "hostname", "nodeIP", "adminKeys"],
      "properties": {
        "sshAddress": {
          "type": "string",
          "minLength": 1
        },
        "hostname": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$"
        },
        "nodeIP": {
          "type": "string",
          "format": "ipv4"
        },
        "privateIP": {
          "type": "string",
          "format": "ipv4"
        },
        "privateInterface": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]{1,15}$"
        },
        "adminKeys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(256|384|521)) [A-Za-z0-9+/]+={0,3}( .*)?$"
          }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "provider",
        "location",
        "sku",
        "architecture",
        "osAdapter",
        "desiredRole",
        "capacity",
        "currentRole",
        "enrollment",
        "capabilities"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^fredrir-[0-9]{2,}$"
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": ["string", "null"]
        },
        "sku": {
          "type": ["string", "null"]
        },
        "architecture": {
          "enum": ["amd64", "arm64"]
        },
        "osAdapter": {
          "enum": ["nixos", "ansible"]
        },
        "desiredRole": {
          "enum": ["server", "worker", "external"]
        },
        "capacity": {
          "$ref": "#/$defs/capacity"
        },
        "currentRole": {
          "type": "string",
          "minLength": 1
        },
        "enrollment": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/enrollment"
            }
          ]
        },
        "capabilities": {
          "$ref": "#/$defs/capabilities"
        },
        "observed": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sshAlias", "publicIPv4", "observedAt"],
          "properties": {
            "sshAlias": {
              "type": "string"
            },
            "publicIPv4": {
              "type": "string",
              "format": "ipv4"
            },
            "observedAt": {
              "type": "string",
              "format": "date"
            },
            "os": {
              "type": "string"
            },
            "kernel": {
              "type": "string"
            },
            "hostname": {
              "type": "string"
            },
            "memoryMiB": {
              "type": "integer",
              "minimum": 1
            },
            "diskGiB": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "networkInterfaces": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "tailnetIPv4": {
              "type": "string",
              "format": "ipv4"
            },
            "tailscaleVersion": {
              "type": "string"
            },
            "privateNetwork": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "ipv4",
                "prefixLength",
                "interface",
                "mtu",
                "gateway",
                "routedCIDRs"
              ],
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 1
                },
                "ipv4": {
                  "type": "string",
                  "format": "ipv4"
                },
                "prefixLength": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 32
                },
                "interface": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_.-]{1,15}$"
                },
                "mtu": {
                  "type": "integer",
                  "minimum": 576,
                  "maximum": 65535
                },
                "gateway": {
                  "type": "string",
                  "format": "ipv4"
                },
                "routedCIDRs": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "placementGroupId": {
              "type": "integer",
              "minimum": 1
            },
            "firewallIds": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "protection": {
              "type": "object",
              "additionalProperties": false,
              "required": ["delete", "rebuild"],
              "properties": {
                "delete": {
                  "type": "boolean"
                },
                "rebuild": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "providerId": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "desiredRole": {
                "const": "server"
              },
              "enrollment": {
                "type": "object"
              }
            }
          },
          "then": {
            "properties": {
              "enrollment": {
                "required": ["privateIP", "privateInterface"]
              }
            }
          }
        }
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "id",
        "status",
        "provider",
        "location",
        "sku",
        "architecture",
        "osAdapter",
        "desiredRole",
        "capacity"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$"
        },
        "id": {
          "type": "null"
        },
        "status": {
          "enum": ["proposed", "provisioned-unenrolled"]
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": ["string", "null"]
        },
        "sku": {
          "type": ["string", "null"]
        },
        "architecture": {
          "enum": ["amd64", "arm64"]
        },
        "osAdapter": {
          "type": "null"
        },
        "desiredRole": {
          "enum": ["server", "worker", "external"]
        },
        "capacity": {
          "$ref": "#/$defs/capacity"
        }
      }
    }
  }
}
