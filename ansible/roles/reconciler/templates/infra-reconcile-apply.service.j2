[Unit]
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=infra-apply
Group=infra-apply
ExecCondition=/usr/local/bin/infra reconcile run pending --config=/etc/infra-reconcile/apply.json
ExecStartPre=+/usr/bin/env SOPS_AGE_KEY_FILE={{ host_secrets_key }} /usr/local/bin/sops decrypt --extract '["apply"]' --output-type json --output %t/infra-reconcile-apply/credentials.json /etc/infra-reconcile/credentials.sops.yaml
ExecStartPre=+/usr/bin/chown infra-apply:infra-apply %t/infra-reconcile-apply/credentials.json
ExecStart=/usr/local/bin/infra reconcile run apply --config=/etc/infra-reconcile/apply.json --credentials=%t/infra-reconcile-apply/credentials.json --ssh-identity=%d/ssh-identity
LoadCredential=ssh-identity:{{ reconciler_ssh_identity }}
RuntimeDirectory=infra-reconcile-apply
RuntimeDirectoryMode=0700
StateDirectory=infra-apply
StateDirectoryMode=0700
CacheDirectory=infra-apply
CacheDirectoryMode=0700
WorkingDirectory=/var/lib/infra-apply
Environment=HOME=/var/lib/infra-apply
TimeoutStartSec=225min
MemoryHigh=5G
MemoryMax=6G
TasksMax=1024
UMask=0077
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
