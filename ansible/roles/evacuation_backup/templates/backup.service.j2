[Unit]
Description=Standalone application recovery points
After=network-online.target user@2001.service
Wants=network-online.target
Requisite=user@2001.service
ConditionPathExists=/var/lib/infra-evacuation/llunde/stage-approved
ConditionPathExists=/var/lib/infra-evacuation/llunde/restore-approved
ConditionPathExists=!/var/lib/platform-evacuation/source-locked
[Service]
Type=oneshot
TimeoutStartSec=960s
TimeoutStopSec=15s
KillMode=control-group
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -B {{ evacuation_backup_tools }}/evacuation_recurring_backup.py --candidate {{ evacuation_backup_candidate }} --credentials /etc/infra-evacuation/llunde/backup --age-identity /var/lib/infra-evacuation/llunde/identity/age.key --work /var/lib/infra-evacuation/llunde/backup-work --ssh-identity /var/lib/infra-evacuation/llunde/identity/backup-status --known-hosts /etc/infra-evacuation/llunde/backup-status-known-hosts --watchdog-address 172.232.145.251
NoNewPrivileges=true
PrivateTmp=true
LimitCORE=0
MemoryMax=512M
CPUQuota=200%
TasksMax=128
