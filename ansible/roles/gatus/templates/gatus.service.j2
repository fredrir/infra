[Unit]
After=network-online.target tailscaled.service
Wants=network-online.target
Requires=tailscaled.service

[Service]
Type=simple
ExecStart=/usr/local/bin/gatus
Environment=GATUS_CONFIG_PATH=%d/config.yaml
Environment=GATUS_LOG_LEVEL=WARN
Environment=GOMEMLIMIT=192MiB
LoadCredential=config.yaml:/etc/gatus/config.yaml
DynamicUser=yes
StateDirectory=gatus
StateDirectoryMode=0700
WorkingDirectory=/var/lib/gatus
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
MemoryHigh=192M
MemoryMax=256M
TasksMax=64
CPUQuota=25%
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
