[Unit]
After=network-online.target tailscaled.service
Wants=network-online.target
Requires=tailscaled.service

[Service]
Type=exec
ExecStartPre=+/usr/bin/env SOPS_AGE_KEY_FILE={{ host_secrets_key }} /usr/local/bin/sops decrypt --output-type dotenv --output /run/gatus/secrets.env /etc/gatus/secrets.sops.yaml
EnvironmentFile=-/run/gatus/secrets.env
ExecStart=/usr/local/bin/gatus
ExecStartPost=+/usr/bin/rm -f /run/gatus/secrets.env
Environment=GATUS_CONFIG_PATH=%d/config.yaml
Environment=GATUS_LOG_LEVEL=WARN
Environment=GOMEMLIMIT=192MiB
LoadCredential=config.yaml:/etc/gatus/config.yaml
DynamicUser=yes
RuntimeDirectory=gatus
RuntimeDirectoryMode=0700
StateDirectory=gatus
StateDirectoryMode=0700
WorkingDirectory=/var/lib/gatus
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
MemoryHigh=192M
MemoryMax=256M
TasksMax=64
CPUQuota=25%
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
