web:
    address: {{ gatus_address }}
    port: {{ gatus_port }}
concurrency: 2
storage:
    type: sqlite
    path: /var/lib/gatus/gatus.db
    maximum-number-of-results: 100
    maximum-number-of-events: 50
alerting:
    email:
        from: alerts@fredrir.com
        host: email-smtp.eu-north-1.amazonaws.com
        password: "${GATUS_SMTP_PASSWORD}"
        port: 587
        to: fhansteen@gmail.com
        username: "${GATUS_SMTP_USERNAME}"
        client:
            insecure: false
        default-alert:
            failure-threshold: 3
            success-threshold: 2
            send-on-resolved: true
endpoints:
    - name: llunde
      group: applications
      url: https://llunde.no/
      interval: 1m
      client:
        timeout: 10s
        ignore-redirect: true
      conditions:
        - '[STATUS] == 200'
      alerts:
        - type: email
    - name: llunde-api-auth
      group: applications
      url: https://api.llunde.no/health
      interval: 1m
      client:
        timeout: 10s
        ignore-redirect: true
      conditions:
        - '[STATUS] == 403'
      alerts:
        - type: email
    - name: parser-access
      group: applications
      url: https://parser.llunde.no/
      interval: 1m
      client:
        timeout: 10s
        ignore-redirect: true
      conditions:
        - '[STATUS] == 302'
      alerts:
        - type: email
    - name: parser-external
      group: applications
      url: https://external.llunde.no/
      interval: 1m
      client:
        timeout: 10s
        ignore-redirect: true
      conditions:
        - '[STATUS] == 404'
      alerts:
        - type: email
    - name: portfolio
      group: applications
      url: https://hansteen.dev/
      interval: 1m
      client:
        timeout: 10s
        ignore-redirect: false
      conditions:
        - '[STATUS] == 200'
      alerts:
        - type: email
    - name: portfolio-origin-auth
      group: applications
      url: https://origin.hansteen.dev/readyz
      interval: 1m
      client:
        timeout: 10s
        ignore-redirect: true
      conditions:
        - '[STATUS] == 403'
      alerts:
        - type: email
    - name: "y"
      group: applications
      url: https://yeeter.no/
      interval: 1m
      client:
        timeout: 10s
        ignore-redirect: true
      conditions:
        - '[STATUS] == 200'
      alerts:
        - type: email
    - name: y-health
      group: applications
      url: https://yeeter.no/healthz
      interval: 1m
      client:
        timeout: 10s
        ignore-redirect: true
      conditions:
        - '[STATUS] == 200'
      alerts:
        - type: email
    - name: y-api
      group: applications
      url: https://yeeter.no/graphql?query=%7B__typename%7D
      interval: 1m
      client:
        timeout: 10s
        ignore-redirect: true
      conditions:
        - '[STATUS] == 200'
        - '[BODY].data.__typename == Query'
      alerts:
        - type: email
      headers:
        x-apollo-operation-name: health
    - name: grafana-login
      group: applications
      url: https://{{ grafana_host }}/login
      interval: 1m
      client:
        timeout: 10s
        ignore-redirect: true
      conditions:
        - '[STATUS] == 200'
      alerts:
        - type: email
    - name: grafana-auth
      group: applications
      url: https://{{ grafana_host }}/api/user
      interval: 1m
      client:
        timeout: 10s
        ignore-redirect: true
      conditions:
        - '[STATUS] == 401'
      alerts:
        - type: email
    - name: logs-redirect
      group: applications
      url: https://fredrir.com/logs
      interval: 1m
      client:
        timeout: 10s
        ignore-redirect: true
      conditions:
        - '[STATUS] == 302'
      alerts:
        - type: email
external-endpoints:
    - name: parser
      group: backups
      token: "${GATUS_TOKEN_BACKUPS_PARSER}"
      heartbeat:
        interval: 8h
      alerts:
        - type: email
          failure-threshold: 1
          success-threshold: 1
          send-on-resolved: true
    - name: "y"
      group: backups
      token: "${GATUS_TOKEN_BACKUPS_Y}"
      heartbeat:
        interval: 8h
      alerts:
        - type: email
          failure-threshold: 1
          success-threshold: 1
          send-on-resolved: true
    - name: portfolio
      group: backups
      token: "${GATUS_TOKEN_BACKUPS_PORTFOLIO}"
      heartbeat:
        interval: 2h
      alerts:
        - type: email
          failure-threshold: 1
          success-threshold: 1
          send-on-resolved: true
    - name: attic
      group: backups
      token: "${GATUS_TOKEN_BACKUPS_ATTIC}"
      heartbeat:
        interval: 2h
      alerts:
        - type: email
          failure-threshold: 1
          success-threshold: 1
          send-on-resolved: true
    - name: control
      group: backups
      token: "${GATUS_TOKEN_BACKUPS_CONTROL}"
      heartbeat:
        interval: 8h
      alerts:
        - type: email
          failure-threshold: 1
          success-threshold: 1
          send-on-resolved: true
    - name: deep
      group: reconciliation
      token: "${GATUS_TOKEN_RECONCILIATION_DEEP}"
      heartbeat:
        interval: 3h
      alerts:
        - type: email
          failure-threshold: 1
          success-threshold: 1
          send-on-resolved: true
          description: Hourly GitHub deep verification failed or stopped reporting; the Gatus result names the run
    - name: verification
      group: reconciliation
      token: "${GATUS_TOKEN_RECONCILIATION_VERIFICATION}"
      heartbeat:
        interval: 2h
      alerts:
        - type: email
          failure-threshold: 2
          success-threshold: 1
          send-on-resolved: true
          description: Reconciler verification failed twice in a row or stopped reporting; the Gatus result names the stage
metrics: true
