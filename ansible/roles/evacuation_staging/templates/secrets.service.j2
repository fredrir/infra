[Unit]
Before=user@2000.service user@2001.service user@2002.service

[Service]
Type=oneshot
RemainAfterExit=true
UMask=0077
ExecStart=/usr/bin/python3 /usr/local/libexec/infra-evacuation-staging render-secrets {{ evacuation_state_directory }}/identity/age.key {{ evacuation_secret_directory }}
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/infra-evacuation
RuntimeDirectory=infra-evacuation
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
