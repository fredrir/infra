#!/usr/bin/env bash
set -euo pipefail
test "$(id -u)" = 0
test -d /run/systemd/system
test -c /dev/net/tun
test "$(stat -fc %T /sys/fs/cgroup)" = cgroup2fs
for controller in cpu memory pids io; do
  grep -qw "$controller" /sys/fs/cgroup/cgroup.controllers
done
test "$(cat /proc/sys/net/ipv4/ip_forward)" = 1
test -z "$(swapon --noheadings --show=NAME)"
ip address show dev tailscale0 | grep -q 'inet '
ip address show | grep -Fq {{ platform_node_ip | quote }}
test "$(findmnt -T /var/lib/rancher -no FSTYPE)" != overlay
/usr/local/bin/k3s --version | head -1 | grep -Fq {{ platform_k3s_version | quote }}
{% for path in ([platform_server_token_file, platform_agent_token_file] if platform_role == 'server' else [platform_agent_token_file]) %}
test -s {{ path | quote }}
test "$(stat -c %u {{ path | quote }})" = 0
stat -c %a {{ path | quote }} | grep -Eq '^(400|600)$'
{% endfor %}
{% if platform_role == 'server' %}
if cmp -s {{ platform_server_token_file | quote }} {{ platform_agent_token_file | quote }}; then
  echo 'Server and agent tokens must differ' >&2
  exit 1
fi
{% endif %}
