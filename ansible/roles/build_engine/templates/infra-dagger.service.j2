[Unit]
After=docker.service network-online.target
Requires=docker.service

[Service]
ExecStartPre=-/usr/bin/docker rm -f {{ build_engine_dagger_name }}
ExecStart=/usr/bin/docker run --rm --name {{ build_engine_dagger_name }} --cgroup-parent=infra-engine.slice --privileged --cpus={{ build_engine_cpus }} --memory={{ build_engine_memory }} --memory-swap={{ build_engine_memory }} --pids-limit={{ build_engine_pids }} --volume infra-dagger-cache:/var/lib/dagger --volume /etc/infra-dagger.toml:/etc/buildkit/buildkitd.toml:ro {{ build_engine_image }} --oci-max-parallelism={{ build_engine_parallelism }} --oci-worker-gc
ExecStop=/usr/bin/docker stop --time 30 {{ build_engine_dagger_name }}
Restart=on-failure
RestartSec=5
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
