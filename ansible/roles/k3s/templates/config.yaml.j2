node-name: {{ inventory_hostname | to_json }}
node-ip: {{ (private_ip if k3s_role == 'server' else tailscale_ip) | to_json }}
node-external-ip: {{ tailscale_ip | to_json }}
token-file: {{ (k3s_server_token_file if k3s_role == 'server' else k3s_agent_token_file) | to_json }}
flannel-iface: tailscale0
{% if inventory_hostname != k3s_registration_server %}
server: {{ ('https://' + k3s_api_endpoint + ':6443') | to_json }}
{% endif %}
kubelet-arg:
  - cgroup-driver=systemd
  - protect-kernel-defaults=true
  - system-reserved=cpu={{ k3s_system_reserved_cpu }},memory={{ k3s_system_reserved_memory }},ephemeral-storage=1Gi
  - kube-reserved=cpu=250m,memory={{ '768Mi' if k3s_role == 'server' else '512Mi' }},ephemeral-storage=2Gi
  - eviction-hard=memory.available<256Mi,nodefs.available<10%,imagefs.available<15%
  - pod-max-pids=1024
  - container-log-max-size=10Mi
  - container-log-max-files=3
{% if k3s_role == 'agent' and k3s_node_taints | length > 0 %}
node-taint: {{ k3s_node_taints | to_json }}
{% endif %}
{% if k3s_role == 'server' %}
agent-token-file: {{ k3s_agent_token_file | to_json }}
advertise-address: {{ private_ip | to_json }}
{% if inventory_hostname == k3s_registration_server %}
cluster-init: true
{% endif %}
cluster-cidr: {{ k3s_pod_cidr | to_json }}
service-cidr: {{ k3s_service_cidr | to_json }}
tls-san:
  - {{ k3s_api_name | to_json }}
{% for host in groups['server'] %}
  - {{ hostvars[host].private_ip | to_json }}
  - {{ hostvars[host].tailscale_ip | to_json }}
{% endfor %}
write-kubeconfig-mode: "0600"
secrets-encryption: true
flannel-backend: vxlan
flannel-external-ip: true
disable: [traefik, servicelb]
node-taint: ["node-role.kubernetes.io/control-plane=true:NoSchedule"]
kube-apiserver-arg: ["authorization-mode=Node,RBAC", "enable-admission-plugins=NodeRestriction"]
etcd-snapshot-schedule-cron: "0 */6 * * *"
etcd-snapshot-retention: 20
{% endif %}
